{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xrpl-lending-monitor",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xrpl-lending-monitor",
      "database_id": "bebc2c68-03d2-4a1c-98a7-46b34ee4e25d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_NETWORK": "devnet",
    "MAINNET_ENABLED": "false",
    "XRPL_DEVNET_RPC_URL": "https://s.devnet.rippletest.net:51234",
    "XRPL_RPC_TIMEOUT_MS": "8000",
    "NETWORK_STATUS_STALE_AFTER_SECONDS": "30",
    "CURRENT_STATE_GITHUB_REPOSITORY": "badjoke-lab/xrpl-lending-monitor",
    "CURRENT_STATE_RELEASE_CHANNEL_TAG": "current-state-channel",
    "CURRENT_STATE_MAX_ASSET_BYTES": "33554432",
    "CURRENT_STATE_MAX_DECOMPRESSED_BYTES": "100663296"
  },
  "observability": {
    "enabled": true
  }
}
