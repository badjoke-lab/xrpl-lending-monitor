{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "WebWorker"],
    "types": ["@cloudflare/workers-types"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/worker/entry.ts",
    "src/worker/index.ts",
    "src/worker/env.ts",
    "src/shared/runtime-config.ts",
    "src/shared/incremental-runtime-config.ts",
    "src/shared/cloudflare-sockets.d.ts"
  ],
  "exclude": ["src/**/*.test.ts"]
}
