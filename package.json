{
  "name": "xrpl-lending-monitor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build && vite build --config vite.d1-tools.config.ts && vite build --config vite.artifact-measurement.config.ts",
    "build:d1-tools": "vite build --config vite.d1-tools.config.ts",
    "build:artifact-measurement": "vite build --config vite.artifact-measurement.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply xrpl-lending-monitor --local",
    "d1:tools": "pnpm build:d1-tools && node .d1-tools-build/run-d1-current-state.mjs",
    "artifact:measure": "pnpm build:artifact-measurement && node .artifact-measurement-build/run-artifact-measurement.mjs",
    "types:worker": "wrangler types",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:migrate:local && pnpm build"
  },
  "dependencies": {
    "@xrpl-commons/ripple-binary-codec": "2.7.0",
    "hono": "4.12.27",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260630.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.6.0",
    "globals": "16.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "wrangler": "4.105.0"
  }
}
