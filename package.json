{
  "name": "xrpl-lending-monitor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build && node scripts/build-discovery-files.mjs && vite build --config vite.d1-tools.config.ts && vite build --config vite.artifact-measurement.config.ts && vite build --config vite.history-segment.config.ts && vite build --config vite.history-segment-checkpoint.config.ts && vite build --config vite.history-segment-chain.config.ts && vite build --config vite.history-segment-publication.config.ts && vite build --config vite.history-segment-channel.config.ts && vite build --config vite.history-exact-index.config.ts && vite build --config vite.incremental-history-exact-index.config.ts && vite build --config vite.history-exact-rehearsal.config.ts && vite build --config vite.history-backfill-plan.config.ts && vite build --config vite.history-extension-plan.config.ts && vite build --config vite.history-extension-artifacts.config.ts && vite build --config vite.extended-history-publication.config.ts && vite build --config vite.replacement-current-state-read-model.config.ts && vite build --config vite.rolling-current-state.config.ts && vite build --config vite.replacement-base-rebase-plan.config.ts && vite build --config vite.t5-cutover-preflight.config.ts && vite build --config vite.candidate-source-rehearsal.config.ts",
    "build:deploy-assets": "vite build && node scripts/build-discovery-files.mjs",
    "build:d1-tools": "vite build --config vite.d1-tools.config.ts",
    "build:artifact-measurement": "vite build --config vite.artifact-measurement.config.ts",
    "build:release-current-state": "vite build --config vite.release-current-state.config.ts",
    "build:history-segment": "vite build --config vite.history-segment.config.ts",
    "build:history-segment-checkpoint": "vite build --config vite.history-segment-checkpoint.config.ts",
    "build:history-segment-chain": "vite build --config vite.history-segment-chain.config.ts",
    "build:history-segment-publication": "vite build --config vite.history-segment-publication.config.ts",
    "build:history-segment-channel": "vite build --config vite.history-segment-channel.config.ts",
    "build:history-exact-index": "vite build --config vite.history-exact-index.config.ts",
    "build:incremental-history-exact-index": "vite build --config vite.incremental-history-exact-index.config.ts",
    "build:history-exact-rehearsal": "vite build --config vite.history-exact-rehearsal.config.ts",
    "build:history-backfill-plan": "vite build --config vite.history-backfill-plan.config.ts",
    "build:history-extension-plan": "vite build --config vite.history-extension-plan.config.ts",
    "build:history-extension-artifacts": "vite build --config vite.history-extension-artifacts.config.ts",
    "build:extended-history-publication": "vite build --config vite.extended-history-publication.config.ts",
    "build:replacement-current-state-read-model": "vite build --config vite.replacement-current-state-read-model.config.ts",
    "build:rolling-current-state": "vite build --config vite.rolling-current-state.config.ts",
    "build:replacement-base-rebase-plan": "vite build --config vite.replacement-base-rebase-plan.config.ts",
    "build:t5-cutover-preflight": "pnpm build:deploy-assets && vite build --config vite.t5-cutover-preflight.config.ts",
    "build:candidate-source-rehearsal": "vite build --config vite.candidate-source-rehearsal.config.ts",
    "discovery:build": "node scripts/build-discovery-files.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply xrpl-lending-monitor --local",
    "d1:migrate:local": "pnpm db:migrate:local",
    "d1:tools": "pnpm build:d1-tools && node .d1-tools-build/run-d1-current-state.mjs",
    "artifact:measure": "pnpm build:artifact-measurement && node .artifact-measurement-build/run-artifact-measurement.mjs",
    "release-current-state:build": "pnpm build:release-current-state",
    "release-current-state:local": "pnpm build:release-current-state && node .release-current-state-build/run-release-current-state.mjs --local",
    "history-segment:build": "pnpm build:history-segment",
    "history-segment:local": "pnpm build:history-segment && node .history-segment-build/run-history-segment.mjs --local",
    "history-segment-checkpoint:build": "pnpm build:history-segment-checkpoint",
    "history-segment-checkpoint:local": "pnpm build:history-segment-checkpoint && node .history-segment-checkpoint-build/update-history-segment-checkpoint.mjs --local",
    "history-segment-chain:build": "pnpm build:history-segment-chain",
    "history-segment-chain:local": "pnpm build:history-segment-chain && node .history-segment-chain-build/verify-history-segment-chain.mjs --local",
    "history-segment-publication:build": "pnpm build:history-segment-publication",
    "history-segment-publication:local": "pnpm build:history-segment-publication && node .history-segment-publication-build/build-history-segment-publication.mjs --local",
    "history-segment-channel:build": "pnpm build:history-segment-channel",
    "history-segment-channel:local": "pnpm build:history-segment-channel && node .history-segment-channel-build/build-history-segment-channel.mjs --local",
    "history-exact-index:build": "pnpm build:history-exact-index",
    "history-exact-index:local": "pnpm build:history-exact-index && node .history-exact-index-build/build-history-exact-index.mjs --local",
    "incremental-history-exact-index:build": "pnpm build:incremental-history-exact-index",
    "incremental-history-exact-index:local": "pnpm build:incremental-history-exact-index && node .incremental-history-exact-index-build/build-incremental-history-exact-index.mjs --local",
    "history-exact-rehearsal:build": "pnpm build:history-exact-rehearsal",
    "history-exact-rehearsal:local": "pnpm build:history-exact-rehearsal && node .history-exact-rehearsal-build/rehearse-history-exact-lookups.mjs --local",
    "history-backfill-plan:build": "pnpm build:history-backfill-plan",
    "history-backfill-plan:local": "pnpm build:history-backfill-plan && node .history-backfill-plan-build/plan-history-backfill.mjs --local",
    "history-extension-plan:build": "pnpm build:history-extension-plan",
    "history-extension-plan:local": "pnpm build:history-extension-plan && node .history-extension-plan-build/plan-history-extension.mjs --local",
    "history-extension-artifacts:build": "pnpm build:history-extension-artifacts",
    "history-extension-artifacts:local": "pnpm build:history-extension-artifacts && node .history-extension-artifacts-build/verify-history-extension-artifacts.mjs --local",
    "extended-history-publication:build": "pnpm build:extended-history-publication",
    "extended-history-publication:local": "pnpm build:extended-history-publication && node .extended-history-publication-build/build-extended-history-publication.mjs --local",
    "replacement-current-state-read-model:build": "pnpm build:replacement-current-state-read-model",
    "replacement-current-state-read-model:local": "pnpm build:replacement-current-state-read-model && node .replacement-current-state-read-model-build/build-replacement-current-state-read-model.mjs --local",
    "rolling-current-state:build": "pnpm build:rolling-current-state",
    "rolling-current-state:local": "pnpm build:rolling-current-state && node .rolling-current-state-build/build-rolling-current-state-read-model.mjs --local",
    "replacement-base-rebase-plan:build": "pnpm build:replacement-base-rebase-plan",
    "replacement-base-rebase-plan:local": "pnpm build:replacement-base-rebase-plan && node .replacement-base-rebase-plan-build/plan-replacement-base-rebase.mjs --local",
    "t5-cutover-preflight:build": "pnpm build:t5-cutover-preflight",
    "t5-cutover-preflight:local": "pnpm build:t5-cutover-preflight && node .t5-cutover-preflight-build/build-t5-cutover-preflight-bundle.mjs --local",
    "candidate-source-rehearsal:build": "pnpm build:candidate-source-rehearsal",
    "candidate-source-rehearsal:local": "pnpm build:candidate-source-rehearsal && node .candidate-source-rehearsal-build/rehearse-candidate-sources.mjs --local",
    "types:worker": "wrangler types",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:migrate:local && pnpm build"
  },
  "dependencies": {
    "@xrpl-commons/ripple-binary-codec": "2.7.0",
    "hono": "4.12.27",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260630.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.6.0",
    "globals": "16.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "wrangler": "4.105.0"
  }
}
